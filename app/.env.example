# Copie para .env e preencha com os dados do projeto Supabase da IrisFlow (o mesmo do site e do desktop).
# São os MESMOS valores de site/.env.local (VITE_*) e frontend/.env.local (VITE_*), com prefixo EXPO_PUBLIC_.
# Sem as variáveis do Supabase o app roda em MODO DEMONSTRAÇÃO (dados simulados, sem rede).
# Nunca coloque aqui a chave service_role — só a anon (pública).
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica-anon

# Site da IrisFlow: base dos links "Baixar no computador" (/beta), "Minha conta" (/conta)
# e "Esqueci a senha" (/recuperar-senha). Sem barra no fim. Padrão: https://irisflow.com.br
EXPO_PUBLIC_SITE_URL=https://irisflow.com.br

# =====================================================================
# IrisFlow Cuidador (Expo) — variáveis de ambiente
#
# Copie para app/.env:
#   cp app/.env.example app/.env
#
# Tudo que começa com EXPO_PUBLIC_ é embutido no JavaScript do app no
# momento do build (`expo start`, `eas build`, `eas update`) e é PÚBLICO por
# definição: qualquer um extrai do APK/IPA. Por isso aqui só entra o que já
# é público (URL e chave anon do Supabase, DSN do Sentry, URL do site).
# NUNCA coloque aqui: service_role do Supabase, token do Sentry, chave do
# Google Play, senhas.
#
# O app sempre usa o Supabase real. Um build sem as duas variáveis do
# Supabase não abre o app: mostra "Não conseguimos conectar agora".
#
# Builds do EAS não dependem deste arquivo: URL e chave anon já estão no
# "env" de cada perfil do eas.json (development / preview / production). O
# `eas update --environment <perfil>` usa só as variáveis do ambiente do EAS,
# cadastradas com os mesmos valores. O app/.env.production, VERSIONADO desde
# 24/09/2026, guarda os valores públicos de produção para o `expo export`
# local; o scripts/conferir-config-publica.mjs barra no CI qualquer segredo nele.
# =====================================================================


# ---------------------------------------------------------------------
# Supabase — projeto "IrisFlow Communicator" (sa-east-1), o mesmo do site
# e do app desktop.
#
# Onde achar: painel do Supabase > Project Settings > API
#   Project URL  -> EXPO_PUBLIC_SUPABASE_URL
#   anon public  -> EXPO_PUBLIC_SUPABASE_ANON_KEY
#
# Só a chave anon (pública); nunca a service_role. Quem protege os dados é
# a RLS. Se trocar de projeto, troque aqui E no eas.json.
# ---------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://xouznaqxhqzjdgeshlmh.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhvdXpuYXF4aHF6amRnZXNobG1oIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAxMjYyODcsImV4cCI6MjEwNTcwMjI4N30.QCQMB5mqsgUvSu3sJBBkfJs2VC-F4vBVEqVKHdp6ujc


# ---------------------------------------------------------------------
# Site da IrisFlow: base dos links "Baixar no computador" (/beta),
# "Minha conta" (/conta), "Fale com a gente" (/contato) e "Esqueci a
# senha". Lido em app/src/lib/config.ts. Sem barra no fim.
# Vazio = https://irisflow.pages.dev.
# A política de privacidade/termos que o app abre NÃO vem daqui: é a URL
# fixa de app.json > extra.privacyPolicyUrl (a mesma cadastrada nas lojas).
# ---------------------------------------------------------------------
EXPO_PUBLIC_SITE_URL=https://irisflow.pages.dev


# ---------------------------------------------------------------------
# Push (não é variável de ambiente, mas é o que falta para o socorro
# acordar o celular com o app fechado em build do projeto):
#   npx eas init            -> preencha extra.eas.projectId em app.json
# Sem projectId não existe token do Expo e o alerta só chega com o app
# aberto (realtime). No Expo Go o push remoto não é usado.
# ---------------------------------------------------------------------


# ---------------------------------------------------------------------
# Sentry — relatório de falhas (OPCIONAL)
#
# Vazio = Sentry desligado: nenhum evento sai do celular. Com o DSN, só
# builds de release enviam (em desenvolvimento o erro fica na tela), sem
# IP, sem captura de tela e sem texto de mensagens (src/lib/sentry.ts).
# Onde achar: sentry.io > Settings > Projects > irisflow-cuidador > Client Keys (DSN).
# O DSN é público por desenho (só permite ENVIAR eventos).
#
# O token de upload de source maps (SENTRY_AUTH_TOKEN) NÃO vai aqui: é
# segredo, cadastre no EAS com visibilidade "secret".
# ---------------------------------------------------------------------
EXPO_PUBLIC_SENTRY_DSN=


# ---------------------------------------------------------------------
# Ambiente lógico (aparece no Sentry). O eas.json define por perfil
# (development / preview / production); localmente pode ficar vazio.
# ---------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=

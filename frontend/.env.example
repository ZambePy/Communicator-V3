# =====================================================================
# IrisFlow desktop (Electron + Vite) — variáveis de ambiente do frontend
#
# Copie para frontend/.env.local e preencha (desenvolvimento):
#   cp frontend/.env.example frontend/.env.local
#
# Sem as variáveis do Supabase o app roda 100% local: nenhuma mensagem sai, e
# a licença vem do serviço simulado (frontend/src/services/license/
# mockLicenseService.ts) — o login continua existindo, com as contas locais
# (admin@irisflow.com / irisflow2026, entre outras).
#
# BUILD DE PRODUÇÃO: o frontend/.env.production é VERSIONADO desde 24/09/2026
# com a configuração pública (URL e chave anon do Supabase, endereço do site),
# e o `vite build` o lê sozinho — por isso todo instalador (release.yml, CI ou
# `npm run electron:build` na sua máquina) sai com login real, sem segredo
# cadastrado. Um instalador de release NUNCA sai sem nuvem: o release.yml
# confere antes de empacotar. O scripts/conferir-config-publica.mjs barra no
# CI qualquer segredo que entre no arquivo.
#
# Tudo que começa com VITE_ é embutido no bundle no momento do build
# (`npm run build` / `npm run electron:build`) — então precisa estar
# preenchido ANTES de gerar o instalador, e nunca pode ser segredo.
# =====================================================================


# ---------------------------------------------------------------------
# Supabase — projeto "IrisFlow Communicator" (o MESMO do site e do app do
# cuidador)
#
# Onde achar: painel do Supabase > Project Settings > API
#   Project URL  -> VITE_SUPABASE_URL   (https://<ref-do-projeto>.supabase.co)
#   anon public  -> VITE_SUPABASE_ANON_KEY
#
# NUNCA a service_role: ela ignora a RLS e iria parar dentro do instalador.
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public

# Edge Function por onde o desktop escreve (heartbeat, sessões, mensagens,
# socorro, relatório de suporte). Só mude se hospedar a função fora do
# Supabase; o padrão é <VITE_SUPABASE_URL>/functions/v1/desktop-sync.
# VITE_DESKTOP_SYNC_URL=


# ---------------------------------------------------------------------
# Site da IrisFlow — links do login ("esqueci a senha" → /recuperar-senha,
# "criar conta" → /cadastro) e das telas de bloqueio ("gerencie a assinatura"
# → /conta). Sem barra no fim. Hoje o site oficial é o do Cloudflare Pages;
# quando houver domínio próprio, troque aqui (e no segredo VITE_SITE_URL do
# GitHub Actions) — o app passa a abrir esse domínio no navegador do sistema
# sem mudar código. Vazio = https://irisflow.pages.dev.
# ---------------------------------------------------------------------
VITE_SITE_URL=https://irisflow.pages.dev

# Dias que uma licença já confirmada continua valendo sem internet
# (carência offline). Padrão 7.
VITE_LICENSE_OFFLINE_DAYS=7


# ---------------------------------------------------------------------
# Só para desenvolvimento (não entram no instalador)
# ---------------------------------------------------------------------
# PIN local da área do cuidador (frontend/src/config/env.ts). Padrão 1234.
# VITE_CAREGIVER_PIN=1234

# URL do Vite dev server que o Electron abre em `npm run electron:dev`
# (electron/dev.mjs e electron/main.ts leem de process.env). Padrão
# http://localhost:5173.
# VITE_DEV_SERVER_URL=http://localhost:5173


# ---------------------------------------------------------------------
# Empacotamento (variável de AMBIENTE do processo, não do Vite)
#
# Atualização automática: o app procura versões no GitHub Releases do
# repositório gravado no instalador (resources/app-update.yml). Quem decide é
# `electron/package-app.mjs`: IRISFLOW_RELEASES_REPO (dono/repo) >
# GITHUB_REPOSITORY (no GitHub Actions) > `build.publish` do package.json da
# raiz. O repositório de releases precisa ser PÚBLICO.
#
# IRISFLOW_CRASH_URL (opcional, ambiente do build): endpoint de minidump
# compatível com Sentry. Sem ela, os relatórios de falha ficam só no
# computador (pasta de logs do app).
# ---------------------------------------------------------------------

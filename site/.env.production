# Configuração PÚBLICA do build de produção do site.
#
# O Cloudflare Pages lê este arquivo no `npm run build` (modo production do
# Vite), então o site sobe e se atualiza sem nenhuma variável digitada no
# painel. Tudo aqui vai para o JavaScript que qualquer visitante baixa: a URL
# do projeto Supabase e a chave anon são públicas por desenho — quem protege os
# dados é a RLS do banco.
#
# NUNCA coloque segredo aqui (chave service_role, senha, token). O
# scripts/conferir-config-publica.mjs barra no CI qualquer chave que não seja a
# anon e qualquer variável fora da lista permitida.
#
# Uma variável definida no painel do Cloudflare (Settings → Variables and
# Secrets) tem prioridade sobre este arquivo. O que cada uma faz está em
# site/.env.example.
VITE_SUPABASE_URL=https://xouznaqxhqzjdgeshlmh.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhvdXpuYXF4aHF6amRnZXNobG1oIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAxMjYyODcsImV4cCI6MjEwNTcwMjI4N30.QCQMB5mqsgUvSu3sJBBkfJs2VC-F4vBVEqVKHdp6ujc
VITE_SITE_URL=https://irisflow.pages.dev
VITE_RELEASES_REPO=ZambePy/Communicator-V3
VITE_RELEASES_AVAILABLE=windows
# APK do app do cuidador: vai anexado a todo release pelo release.yml (passo
# "APK do app do cuidador", variável de repositório IRISFLOW_APK_CUIDADOR_URL).
VITE_APP_CUIDADOR_URL=https://github.com/ZambePy/Communicator-V3/releases/latest/download/IrisFlow-Cuidador.apk

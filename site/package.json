{
  "name": "irisflow-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Site institucional e de contratacao da IrisFlow — plataforma de comunicacao assistiva por rastreamento ocular.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integracao": "node scripts/check-supabase.mjs",
    "check": "node scripts/check-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^3.2.7"
  }
}

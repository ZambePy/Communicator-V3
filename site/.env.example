# =====================================================================
# IrisFlow — variáveis de ambiente
#
# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto (desenvolvimento, `npm run dev`). O .gitignore ignora .env e
# .env.*, com duas exceções: este .env.example e o .env.production.
#
#   cp .env.example .env.local          # desenvolvimento (npm run dev)
#
# O BUILD DE PRODUÇÃO usa o site/.env.production, VERSIONADO desde
# 24/09/2026: a configuração pública do site (URL e chave anon do Supabase,
# endereço do site, repositório de releases). O Cloudflare Pages o lê no
# `npm run build`, então nenhuma variável precisa ser cadastrada no painel —
# uma variável cadastrada lá (Settings > Variables and Secrets) tem
# prioridade sobre o arquivo. O scripts/conferir-config-publica.mjs barra no
# CI qualquer segredo que entre nele.
#
# Variáveis lidas pelo código (grep VITE_ em src/ e vite.config.ts):
# VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_SITE_URL,
# VITE_RELEASES_REPO, VITE_RELEASES_AVAILABLE, VITE_CF_ANALYTICS_TOKEN,
# VITE_APP_CUIDADOR_URL, VITE_PAYMENT_PUBLIC_KEY, VITE_API_URL. Todas abaixo.
#
# Tudo que começa com VITE_ é embutido no bundle e fica visível para
# qualquer visitante do site. Não existe variável secreta aqui: se um
# valor não pode ser lido por estranhos, ele não entra neste arquivo.
# =====================================================================


# ---------------------------------------------------------------------
# Supabase
#
# Onde achar: painel do Supabase > Project Settings > API
#   Project URL  -> VITE_SUPABASE_URL   formato https://<ref>.supabase.co, sem barra
#                                       nem /rest/v1 no fim (ex.: o projeto
#                                       "IrisFlow Communicator" é
#                                       https://xouznaqxhqzjdgeshlmh.supabase.co)
#   anon public  -> VITE_SUPABASE_ANON_KEY
#
# A chave anônima é pública por definição: ela vai no JavaScript do site
# e todo mundo consegue lê-la. Quem protege os dados é a Row Level
# Security das migrações em ../supabase/migrations/, não o segredo da chave.
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public


# ---------------------------------------------------------------------
# ATENÇÃO: a service_role key NÃO entra aqui
#
# O painel do Supabase mostra, logo abaixo da anon, uma chave chamada
# service_role. Ela ignora toda a Row Level Security e dá acesso
# irrestrito ao banco. Prefixada com VITE_, ela seria publicada no
# bundle do site e qualquer pessoa poderia ler e apagar a base inteira.
#
# Ela só pode ser usada no servidor: Edge Functions do Supabase ou um
# back-end seu, onde vira variável de ambiente sem prefixo VITE_.
# ---------------------------------------------------------------------


# ---------------------------------------------------------------------
# Origem pública do site
#
# Base de canonical, og:url, og:image, sitemap.xml e robots.txt (gerados
# no build a partir de src/seo/pages.ts). Sem barra no fim. Vazia = o
# padrão de src/seo/site.ts (https://irisflow-communicator.pages.dev). Troque quando o
# domínio próprio apontar (ex.: https://irisflow.tech).
#
# Também é o destino dos links dos e-mails de conta: confirmação de
# cadastro -> <VITE_SITE_URL>/entrar; nova senha -> <VITE_SITE_URL>/nova-senha.
# As duas URLs precisam estar em Supabase > Authentication > URL
# Configuration > Redirect URLs.
# ---------------------------------------------------------------------
VITE_SITE_URL=https://irisflow-communicator.pages.dev


# ---------------------------------------------------------------------
# Instaladores do desktop — GitHub Releases (src/lib/releases.ts)
#
# O navegador consulta, sem token, a API pública do GitHub:
#   https://api.github.com/repos/<VITE_RELEASES_REPO>/releases/latest
# e mostra os arquivos do último release pela extensão (.exe Windows;
# .dmg macOS, Apple Silicon e Intel; .AppImage e .deb Linux). Sistema sem
# arquivo no release aparece como "Em breve". A resposta fica 10 minutos
# em cache na aba. Os releases precisam ser públicos para o visitante
# baixar sem login.
#
# VITE_RELEASES_AVAILABLE: plano B, usado só quando a API falha ou estoura
# o limite de 60 consultas por hora por IP — sistemas com instalador,
# separados por vírgula, com links para
#   https://github.com/<VITE_RELEASES_REPO>/releases/latest/download/<arquivo>
# (nomes em RELEASE_FILES). Também é a base das frases "em preparação"
# espalhadas pelo site, fora dos painéis de download. Vazia = windows.
# ---------------------------------------------------------------------
VITE_RELEASES_REPO=ZambePy/Communicator-V3
VITE_RELEASES_AVAILABLE=windows


# ---------------------------------------------------------------------
# Estatísticas — Cloudflare Web Analytics (sem cookies)
#
# Token do site em Cloudflare > Analytics & Logs > Web Analytics > Add a
# site (modo manual, "JS snippet": o token é o valor de "token" no
# data-cf-beacon). Vazio = nenhuma estatística é coletada. O beacon só
# carrega se o visitante não clicar em "Recusar estatísticas".
# NÃO ligue o Web Analytics automático do projeto no Pages: ele injeta o
# beacon por conta própria e ignora a recusa do visitante.
# ---------------------------------------------------------------------
VITE_CF_ANALYTICS_TOKEN=


# ---------------------------------------------------------------------
# App do cuidador
# ---------------------------------------------------------------------
# Link do app do cuidador (APK, link do Expo ou página na loja). Com ele
# vazio, a página /beta diz que o link chega por e-mail. Em produção
# (site/.env.production) é o APK anexado ao release mais recente:
#   https://github.com/<VITE_RELEASES_REPO>/releases/latest/download/IrisFlow-Cuidador.apk
# — o release.yml o anexa a todo release (variável de repositório
# IRISFLOW_APK_CUIDADOR_URL ou o APK do release anterior).
VITE_APP_CUIDADOR_URL=


# ---------------------------------------------------------------------
# Gateway de pagamento (opcional enquanto a contratação estiver fechada)
# Durante a beta NENHUM gateway está ligado: a compra de planos fica
# indisponível (plans.purchasable = false) e esta chave pode ficar vazia.
#
# Chave PÚBLICA do gateway, usada pelo SDK no navegador para tokenizar
# o cartão. É a contrapartida do tokenizeCard em src/services/api.ts.
# A chave privada fica no servidor, nunca aqui.
#
#   Stripe        -> publishable key (pk_...)
#   Mercado Pago  -> public key (APP_USR-...)
#   Pagar.me      -> encryption key (ek_...)
# ---------------------------------------------------------------------
VITE_PAYMENT_PUBLIC_KEY=


# ---------------------------------------------------------------------
# API própria (opcional)
#
# Só é necessária se você subir Edge Functions ou um back-end à parte
# para webhooks do gateway. Falando direto com o Supabase pelo
# supabase-js, pode ficar vazia.
# ---------------------------------------------------------------------
VITE_API_URL=


# ---------------------------------------------------------------------
# Webhook do gateway (NÃO vai aqui — são segredos da Edge Function)
#
# A função supabase/functions/payment-webhook recebe os eventos do gateway
# e move a assinatura (paga → ativa, falhou → inadimplente). Os segredos
# ficam no Supabase, nunca no bundle:
#
#   supabase secrets set PAYMENT_GATEWAY=stripe|mercadopago|pagarme
#   supabase secrets set PAYMENT_WEBHOOK_SECRET=<segredo do webhook>
#
# O mesmo e-mail e senha criados neste site abrem o app desktop e o app do
# cuidador: eles usam VITE_SUPABASE_URL / ANON_KEY iguais aos daqui.
# ---------------------------------------------------------------------
